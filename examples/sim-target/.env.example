# Copy to .env (gitignored) and fill in. run.sh sources this automatically.

# prism gateway base the agent calls (connect / check / config poll / telemetry).
# Defaults to https://prism.p.compfly.ai when unset.
COMPFLY_API_URL=https://prism.p.compfly.ai

# The agent's DID + Ed25519 private key. Get these by registering the agent and minting its
# identity in the CompFly platform (see README.md — via the CompFly MCP).
COMPFLY_AGENT_DID=did:compfly:REPLACE_ME
COMPFLY_AGENT_PRIVATE_KEY_PATH=/absolute/path/to/agent.pem

# HTTP listen address for the chat endpoint the eval engine drives.
SIM_TARGET_ADDR=:8899

# Advanced: override the telemetry WebSocket URL. Normally unset (the gateway is authoritative).
# COMPFLY_SIM_TELEMETRY_URL=
