# Copy to .env (gitignored) and fill in. run.sh sources this automatically.

# prism gateway base the agent calls (connect / check / config poll / telemetry).
COMPFLY_API_URL=http://localhost:8080

# The agent's DID + Ed25519 private key. Get these by registering the agent and minting
# its identity (see README.md — via the CompFly MCP, or the local k3d helper script).
COMPFLY_AGENT_DID=did:compfly:REPLACE_ME
COMPFLY_AGENT_PRIVATE_KEY_PATH=/absolute/path/to/agent.pem

# HTTP listen address for the chat endpoint the eval engine drives.
SIM_TARGET_ADDR=:8899

# Split-horizon override (LOCAL DEV ONLY): when the agent runs on your host but the gateway
# hands back an in-cluster telemetry URL (e.g. ws://prism:8080) the host can't resolve, pin
# the telemetry WebSocket to the port-forwarded gateway. Leave unset in normal deployments.
# COMPFLY_SIM_TELEMETRY_URL=ws://localhost:8080/v1/simulation/telemetry
