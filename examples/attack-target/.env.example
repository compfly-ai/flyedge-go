# Copy to .env (gitignored). run.sh and drive.sh source this automatically.

# prism gateway base the agent calls.
COMPFLY_API_URL=http://localhost:8080

# The agent's DID + Ed25519 key (register + mint via the MCP, or the local k3d helper — see README).
COMPFLY_AGENT_DID=did:compfly:REPLACE_ME
COMPFLY_AGENT_PRIVATE_KEY_PATH=/absolute/path/to/agent.pem

# Split-horizon override (host agent ↔ in-cluster gateway): pin the telemetry WS to the port-forward.
COMPFLY_SIM_TELEMETRY_URL=ws://localhost:8080/v1/simulation/telemetry

# Optional — enables config_inject (a real governed LLM call whose body gets rewritten in attack mode).
# ANTHROPIC_API_KEY=sk-ant-...

# drive.sh (attack-sim control) — usually the defaults are fine locally.
# INTERNAL_KEY=dev-internal-api-key
# AGENT=go-sim-agent
# TARGET_TOOL=get_account
# SOPH=2
# PROTECTION_DISABLED=true
