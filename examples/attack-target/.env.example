# Copy to .env (gitignored). run.sh and drive.sh source this automatically.

# prism gateway base the agent calls. Defaults to https://prism.p.compfly.ai when unset.
COMPFLY_API_URL=https://prism.p.compfly.ai

# The agent's DID + Ed25519 key. Register an agent and mint its identity in the CompFly platform.
COMPFLY_AGENT_DID=did:compfly:REPLACE_ME
COMPFLY_AGENT_PRIVATE_KEY_PATH=/absolute/path/to/agent.pem

# Advanced: override the telemetry WebSocket URL. Normally unset (the gateway is authoritative).
# COMPFLY_SIM_TELEMETRY_URL=

# Optional — enables config_inject (a real governed LLM call whose body gets rewritten in attack mode).
# ANTHROPIC_API_KEY=sk-ant-...

# drive.sh (attack-sim control) — override the target of the attack simulation if needed.
# AGENT=my-sim-agent
# TARGET_TOOL=get_account
# SOPH=2
# PROTECTION_DISABLED=true
